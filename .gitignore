# ================================================================
# ملف .gitignore
# --------------
# يمنع رفع الملفات الحساسة وغير الضرورية إلى GitHub.
# هام جداً: لا ترفع ملف .env أبداً (يحتوي على التوكن).
# ================================================================

# الأسرار والإعدادات المحلية
.env
.env.*
!.env.example

# ملفات بايثون المؤقتة
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
env/

# مجلدات التخزين والمشروع (تُنشأ تلقائياً عند التشغيل)
storage/
logs/

# ملفات النظام
.DS_Store
Thumbs.db

# أدوات التحرير
.idea/
.vscode/
