# ================================================================
# .dockerignore — يمنع نسخ الملفات غير الضرورية إلى صورة Docker
# ================================================================

# الأسرار
.env
.env.*

# بيئات بايثون المحلية
.venv*/
venv/
env/

# بيانات التشغيل (تُنشأ تلقائياً)
storage/database.db
storage/models/
storage/temp/
storage/backups/
logs/

# ملفات بايثون المؤقتة
__pycache__/
*.py[cod]
*.egg-info/

# نظام
.DS_Store
Thumbs.db
.idea/
.vscode/

# مستودع git
.git/
