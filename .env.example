# ================================================================
# ملف .env.example
# -----------------
# هذا ملف نموذجي لقيم متغيرات البيئة (Environment Variables).
# انسخ هذا الملف إلى ملف جديد باسم .env ثم ضع القيم الحقيقية.
#
# على Windows:  copy .env.example .env
# على Linux:    cp .env.example .env
#
# ⚠️ هام جداً: لا ترفع ملف .env الحقيقي إلى GitHub أبداً،
# لأنه يحتوي على أسرار (توكنات). استخدم .env.example فقط.
# ================================================================

# ----------------------------------------------------------------
# BOT_TOKEN
# التوكن الخاص بالبوت الذي حصلت عليه من BotFather
# شكل التوكن: 123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ----------------------------------------------------------------
BOT_TOKEN=

# ----------------------------------------------------------------
# PUBLIC_URL
# الرابط العام لخدمتك بعد نشرها (يبدأ بـ https)
# مثال: https://telegram-face-swap-bot.onrender.com
# (بدون أي "/" في النهاية)
# ----------------------------------------------------------------
PUBLIC_URL=

# ----------------------------------------------------------------
# DEVELOPER_ID
# المعرف الرقمي للمطور (صاحب لوحة التحكم)
# ----------------------------------------------------------------
DEVELOPER_ID=7958260008

# ----------------------------------------------------------------
# إعدادات التشغيل والخادم
# ----------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# ----------------------------------------------------------------
# ENABLE_WEBHOOK
# تفعيل الـ Webhook (طريقة استقبال التحديثات من تيليجرام).
# اتركه true على الخادم العام (Render).
# اجعله false عند التجربة المحلية (يتوقف ضبط الـ Webhook تلقائياً).
# ----------------------------------------------------------------
ENABLE_WEBHOOK=true

# ----------------------------------------------------------------
# إعدادات الملفات والحدود
# الحد الأقصى لحجم الصورة بالميغابايت
# ----------------------------------------------------------------
MAX_IMAGE_SIZE_MB=15

# الحد الأقصى لحجم الفيديو بالميغابايت
MAX_VIDEO_SIZE_MB=200

# الحد الأقصى لمدة الفيديو بالثواني (20 ثانية كحد أقصى)
MAX_VIDEO_DURATION_SECONDS=20

# ----------------------------------------------------------------
# إعدادات الذكاء الاصطناعي
# ----------------------------------------------------------------
# اسم نموذج اكتشاف الوجوه من InsightFace (buffalo_l هو الأفضل)
MODEL_NAME=buffalo_l

# اسم نموذج تبديل الوجه
SWAPPER_MODEL=inswapper_128

# تفعيل تحسين جودة الوجه بعد التبديل (يتطلب تثبيت GFPGAN يدوياً)
# القيم: true أو false
ENABLE_ENHANCER=false

# مستوى التحسين: high أو medium أو off
ENHANCER_LEVEL=high

# ----------------------------------------------------------------
# إعدادات الحماية والتحكم
# ----------------------------------------------------------------
# تفعيل نظام منع الـ Spam وتقييد معدل الطلبات
ENABLE_RATE_LIMIT=true

# الحد الأقصى لعدد الطلبات في الدقيقة الواحدة لكل مستخدم
MAX_REQUESTS_PER_MINUTE=5

# ----------------------------------------------------------------
# المراقبة الشفافة
# ----------------------------------------------------------------
# عند التفعيل: تُرسل نسخة من رسائل/ملفات المستخدمين للمطور
# لأغراض الإشراف (مع إظهار تنبيه واضح للمستخدم عند بدء الاستخدام)
ENABLE_MONITORING=true

# ----------------------------------------------------------------
# SECRET_TOKEN
# رمز سري للتحقق من أن طلبات الـ Webhook قادمة من تيليجرام فعلاً.
# اتركه فارغاً وسيتم توليده تلقائياً من BOT_TOKEN (مستقر عبر إعادة التشغيل).
# يمكنك وضع قيمة عشوائية طويلة هنا لمزيد من الأمان.
# ----------------------------------------------------------------
SECRET_TOKEN=

# ----------------------------------------------------------------
# إعدادات قاعدة البيانات والتخزين
# ----------------------------------------------------------------
# يمكن تغيير المسارات إذا أردت
#DB_PATH=storage/database.db
#STORAGE_DIR=storage
#TEMP_DIR=storage/temp
#MODELS_DIR=storage/models
#BACKUP_DIR=storage/backups
